{%- comment -%}
  L'Écurie Paris store locator. Stores come from the "store_location" metaobjects
  (Shopify admin > Content > Metaobjects > Store location). Map: MapLibre GL + OpenFreeMap.
{%- endcomment -%}
{%- liquid
  assign stores = shop.metaobjects.store_location.values
-%}
<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css">
<style>
  #lpsl-{{ section.id }}{--ink:#230d09;--cream:#f9f4ed;--sand:#efe6d8;--gold:#a37a32;--line:rgba(35,13,9,.14);background:var(--cream);color:var(--ink);padding:0 0 72px}
  #lpsl-{{ section.id }} .lpsl{display:grid;grid-template-columns:380px minmax(0,1fr);height:680px;max-width:1440px;margin:0 auto;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  #lpsl-{{ section.id }} .lpsl__panel{display:flex;flex-direction:column;min-height:0;border-right:1px solid var(--line);background:var(--cream)}
  #lpsl-{{ section.id }} .lpsl__tools{padding:22px 24px 16px;border-bottom:1px solid var(--line)}
  #lpsl-{{ section.id }} .lpsl__search{width:100%;box-sizing:border-box;border:1px solid var(--line);background:#fff;padding:12px 14px;font:inherit;font-size:12px;letter-spacing:.06em;color:var(--ink);outline:none;border-radius:0}
  #lpsl-{{ section.id }} .lpsl__search:focus{border-color:var(--ink)}
  #lpsl-{{ section.id }} .lpsl__row{display:flex;justify-content:space-between;align-items:center;margin-top:12px;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase}
  #lpsl-{{ section.id }} .lpsl__btn{background:none;border:0;padding:0;color:var(--ink);font:inherit;letter-spacing:inherit;text-transform:inherit;cursor:pointer;border-bottom:1px solid currentColor}
  #lpsl-{{ section.id }} .lpsl__count{opacity:.6}
  #lpsl-{{ section.id }} .lpsl__list{list-style:none;margin:0;padding:0;overflow-y:auto;flex:1;min-height:0}
  #lpsl-{{ section.id }} .lpsl__item{padding:18px 24px;border-bottom:1px solid var(--line);cursor:pointer;transition:background .2s}
  #lpsl-{{ section.id }} .lpsl__item:hover,#lpsl-{{ section.id }} .lpsl__item.is-active{background:var(--sand)}
  #lpsl-{{ section.id }} .lpsl__name{font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;margin:0 0 6px;display:flex;justify-content:space-between;gap:12px}
  #lpsl-{{ section.id }} .lpsl__dist{font-size:10px;opacity:.55;white-space:nowrap}
  #lpsl-{{ section.id }} .lpsl__addr{font-size:12px;line-height:1.55;opacity:.8;margin:0}
  #lpsl-{{ section.id }} .lpsl__links{display:flex;gap:16px;margin-top:10px;font-size:10px;letter-spacing:.1em;text-transform:uppercase}
  #lpsl-{{ section.id }} .lpsl__links a{color:var(--ink);text-decoration:none;border-bottom:1px solid rgba(35,13,9,.35)}
  #lpsl-{{ section.id }} .lpsl__links a:hover{border-color:var(--ink)}
  #lpsl-{{ section.id }} .lpsl__empty{padding:28px 24px;font-size:12px;opacity:.7}
  #lpsl-{{ section.id }} .lpsl__map{position:relative;min-height:0}
  #lpsl-{{ section.id }} .lpsl__map>div{position:absolute;inset:0}
  #lpsl-{{ section.id }} .maplibregl-popup-content{background:var(--cream);color:var(--ink);border-radius:0;padding:16px 18px;box-shadow:0 8px 28px rgba(35,13,9,.18);font-family:inherit;min-width:220px}
  #lpsl-{{ section.id }} .maplibregl-popup-tip{border-top-color:var(--cream);border-bottom-color:var(--cream)}
  #lpsl-{{ section.id }} .maplibregl-popup-close-button{font-size:18px;padding:2px 8px;color:var(--ink)}
  #lpsl-{{ section.id }} .lpsl__pop-name{font-size:12px;letter-spacing:.08em;text-transform:uppercase;margin:0 0 6px}
  #lpsl-{{ section.id }} .maplibregl-ctrl-group{border-radius:0;box-shadow:none;border:1px solid var(--line)}
  @media (max-width: 899px){
    #lpsl-{{ section.id }} .lpsl{grid-template-columns:1fr;height:auto}
    #lpsl-{{ section.id }} .lpsl__map{order:-1;height:380px}
    #lpsl-{{ section.id }} .lpsl__panel{border-right:0}
    #lpsl-{{ section.id }} .lpsl__list{max-height:520px}
    #lpsl-{{ section.id }} .lpsl__tools{padding:18px 16px 14px}
    #lpsl-{{ section.id }} .lpsl__item{padding:16px}
  }
</style>

<div id="lpsl-{{ section.id }}" class="lpsl-wrap">
  <div class="lpsl">
    <div class="lpsl__panel">
      <div class="lpsl__tools">
        <input class="lpsl__search" type="search" placeholder="{{ section.settings.search_placeholder | escape }}" aria-label="Search stores" data-lpsl-search>
        <div class="lpsl__row">
          <button type="button" class="lpsl__btn" data-lpsl-near>Near me</button>
          <span class="lpsl__count" data-lpsl-count></span>
          <button type="button" class="lpsl__btn" data-lpsl-all>View all</button>
        </div>
      </div>
      <ul class="lpsl__list" data-lpsl-list></ul>
    </div>
    <div class="lpsl__map"><div data-lpsl-map></div></div>
  </div>
</div>

<script type="application/json" data-lpsl-data="{{ section.id }}">
[
{%- for s in stores -%}
  {%- if s.active.value == false -%}{%- continue -%}{%- endif -%}
  {%- if s.latitude.value == blank or s.longitude.value == blank -%}{%- continue -%}{%- endif -%}
  {"name":{{ s.name.value | json }},"address":{{ s.address.value | default: '' | json }},"city":{{ s.city.value | default: '' | json }},"state":{{ s.state.value | default: '' | json }},"zip":{{ s.postal_code.value | default: '' | json }},"country":{{ s.country.value | default: '' | json }},"phone":{{ s.phone.value | default: '' | json }},"web":{{ s.website.value | default: '' | json }},"lat":{{ s.latitude.value | json }},"lng":{{ s.longitude.value | json }}}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
</script>

<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js" defer></script>
<script>
(function(){
  var root=document.getElementById('lpsl-{{ section.id }}'); if(!root) return;
  var raw=document.querySelector('[data-lpsl-data="{{ section.id }}"]').textContent.replace(/,\s*\]/,']');
  var stores=JSON.parse(raw).map(function(s,i){s.id=i;s.lat=+s.lat;s.lng=+s.lng;return s}).sort(function(a,b){return a.name.localeCompare(b.name)});
  var listEl=root.querySelector('[data-lpsl-list]'), countEl=root.querySelector('[data-lpsl-count]'), searchEl=root.querySelector('[data-lpsl-search]');
  var map, popup, userPos=null, query='', boundsFilter=true, activeId=null;

  function esc(t){return String(t||'').replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
  function line2(s){return [s.city,[s.state,s.zip].filter(Boolean).join(' ')].filter(Boolean).join(', ')}
  function dirs(s){return 'https://www.google.com/maps/dir/?api=1&destination='+encodeURIComponent([s.name,s.address,s.city,s.state,s.zip,s.country].filter(Boolean).join(', '))}
  function km(a,b){var R=6371,dl=(b.lat-a.lat)*Math.PI/180,dg=(b.lng-a.lng)*Math.PI/180,x=Math.sin(dl/2)*Math.sin(dl/2)+Math.cos(a.lat*Math.PI/180)*Math.cos(b.lat*Math.PI/180)*Math.sin(dg/2)*Math.sin(dg/2);return 2*R*Math.asin(Math.sqrt(x))}
  function fmtDist(k){var mi=k*0.621371;return mi<10?mi.toFixed(1)+' mi':Math.round(mi)+' mi'}
  function card(s){
    var links='<a href="'+dirs(s)+'" target="_blank" rel="noopener">Directions</a>'+(s.phone?'<a href="tel:'+esc(s.phone.replace(/[^+\d]/g,''))+'">'+esc(s.phone)+'</a>':'')+(s.web?'<a href="'+esc(s.web)+'" target="_blank" rel="noopener">Website</a>':'');
    return '<p class="lpsl__addr">'+esc(s.address)+(s.address?'<br>':'')+esc(line2(s))+'<br>'+esc(s.country)+'</p><div class="lpsl__links">'+links+'</div>';
  }
  function matches(s){if(!query) return true; var h=[s.name,s.address,s.city,s.state,s.zip,s.country].join(' ').toLowerCase(); return query.split(/\s+/).every(function(w){return h.indexOf(w)>-1})}
  function visible(){
    var list=stores.filter(matches);
    if(map && boundsFilter && !query){var b=map.getBounds(); list=list.filter(function(s){return b.contains([s.lng,s.lat])})}
    if(userPos){list.forEach(function(s){s.d=km(userPos,s)}); list.sort(function(a,b){return a.d-b.d})}
    return list;
  }
  function render(){
    var list=visible();
    countEl.textContent=list.length+(list.length===1?' boutique':' boutiques');
    if(!list.length){listEl.innerHTML='<li class="lpsl__empty">No boutique in this area. Zoom out or view all.</li>';return}
    listEl.innerHTML=list.map(function(s){return '<li class="lpsl__item'+(s.id===activeId?' is-active':'')+'" data-id="'+s.id+'"><p class="lpsl__name"><span>'+esc(s.name)+'</span>'+(userPos?'<span class="lpsl__dist">'+fmtDist(s.d)+'</span>':'')+'</p>'+card(s)+'</li>'}).join('');
  }
  function openStore(s,fly){
    activeId=s.id;
    if(fly) map.flyTo({center:[s.lng,s.lat],zoom:Math.max(map.getZoom(),14),speed:1.4});
    if(popup) popup.remove();
    popup=new maplibregl.Popup({offset:14,maxWidth:'280px'}).setLngLat([s.lng,s.lat]).setHTML('<p class="lpsl__pop-name">'+esc(s.name)+'</p>'+card(s)).addTo(map);
    map.getSource('lpsl').setData(geo());
    render();
  }
  function geo(){return {type:'FeatureCollection',features:stores.filter(matches).map(function(s){return {type:'Feature',geometry:{type:'Point',coordinates:[s.lng,s.lat]},properties:{id:s.id,active:s.id===activeId?1:0}}})}}
  function fitAll(list){
    list=list||stores.filter(matches); if(!list.length) return;
    var b=new maplibregl.LngLatBounds(); list.forEach(function(s){b.extend([s.lng,s.lat])});
    map.fitBounds(b,{padding:{top:60,bottom:60,left:60,right:60},maxZoom:13,duration:800});
  }
  function restyle(){
    var st=map.getStyle(); if(!st||!st.layers) return;
    st.layers.forEach(function(l){
      var id=l.id;
      try{
        if(l.type==='background') map.setPaintProperty(id,'background-color','#f4eee4');
        else if(l.type==='fill'){ if(/water/.test(id)) map.setPaintProperty(id,'fill-color','#ddd3c4'); else if(/park|green|wood|grass/.test(id)) map.setPaintProperty(id,'fill-color','#ebe3d3'); else if(/building/.test(id)) map.setPaintProperty(id,'fill-color','#e9e0d1'); else map.setPaintProperty(id,'fill-color','#f0e9dd'); }
        else if(l.type==='line'){ if(/water|river/.test(id)) map.setPaintProperty(id,'line-color','#d6cbbb'); else if(/boundary|admin/.test(id)) map.setPaintProperty(id,'line-color','#c2b3a0'); else map.setPaintProperty(id,'line-color','#ffffff'); }
        else if(l.type==='symbol' && l.layout && l.layout['text-field']){ map.setPaintProperty(id,'text-color','#7a675d'); map.setPaintProperty(id,'text-halo-color','#f4eee4'); map.setPaintProperty(id,'text-halo-width',1.2); }
      }catch(e){}
    });
  }
  function init(){
    map=new maplibregl.Map({container:root.querySelector('[data-lpsl-map]'),style:'https://tiles.openfreemap.org/styles/positron',center:[-40,40],zoom:2,attributionControl:{compact:true},cooperativeGestures:window.matchMedia('(max-width: 899px)').matches});
    map.addControl(new maplibregl.NavigationControl({showCompass:false}),'top-right');
    map.on('load',function(){
      restyle();
      map.addSource('lpsl',{type:'geojson',data:geo(),cluster:true,clusterRadius:42,clusterMaxZoom:12});
      map.addLayer({id:'lpsl-cl',type:'circle',source:'lpsl',filter:['has','point_count'],paint:{'circle-color':'#230d09','circle-radius':['step',['get','point_count'],15,5,19,15,24],'circle-stroke-color':'#f9f4ed','circle-stroke-width':2}});
      map.addLayer({id:'lpsl-cl-n',type:'symbol',source:'lpsl',filter:['has','point_count'],layout:{'text-field':['get','point_count_abbreviated'],'text-font':['Noto Sans Regular'],'text-size':12},paint:{'text-color':'#f9f4ed'}});
      map.addLayer({id:'lpsl-pt',type:'circle',source:'lpsl',filter:['!',['has','point_count']],paint:{'circle-color':['case',['==',['get','active'],1],'#a37a32','#230d09'],'circle-radius':['case',['==',['get','active'],1],9,7],'circle-stroke-color':'#f9f4ed','circle-stroke-width':2}});
      map.on('click','lpsl-cl',function(e){var f=map.queryRenderedFeatures(e.point,{layers:['lpsl-cl']})[0];map.getSource('lpsl').getClusterExpansionZoom(f.properties.cluster_id).then(function(z){map.easeTo({center:f.geometry.coordinates,zoom:z+0.5})})});
      map.on('click','lpsl-pt',function(e){var id=e.features[0].properties.id;openStore(stores.find(function(s){return s.id===id}),false)});
      ['lpsl-cl','lpsl-pt'].forEach(function(l){map.on('mouseenter',l,function(){map.getCanvas().style.cursor='pointer'});map.on('mouseleave',l,function(){map.getCanvas().style.cursor=''})});
      map.on('moveend',render);
      fitAll(); render();
    });
  }
  listEl.addEventListener('click',function(e){if(e.target.closest('a')) return; var li=e.target.closest('[data-id]'); if(!li) return; openStore(stores.find(function(s){return s.id===+li.dataset.id}),true)});
  searchEl.addEventListener('input',function(){query=searchEl.value.trim().toLowerCase(); if(map&&map.getSource('lpsl')){map.getSource('lpsl').setData(geo()); if(query) fitAll()} render()});
  root.querySelector('[data-lpsl-all]').addEventListener('click',function(){query='';searchEl.value='';userPos=null;activeId=null;if(popup)popup.remove();map.getSource('lpsl').setData(geo());fitAll();render()});
  root.querySelector('[data-lpsl-near]').addEventListener('click',function(){
    if(!navigator.geolocation) return;
    navigator.geolocation.getCurrentPosition(function(p){userPos={lat:p.coords.latitude,lng:p.coords.longitude}; var near=stores.slice().sort(function(a,b){return km(userPos,a)-km(userPos,b)}).slice(0,3); near.push({lat:userPos.lat,lng:userPos.lng}); fitAll(near); render()},function(){},{timeout:8000});
  });
  function boot(){ if(window.maplibregl) init(); else setTimeout(boot,60) }
  render(); boot();
})();
</script>

{% schema %}
{
  "name": "LP store locator",
  "settings": [
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search a city, state or boutique" }
  ],
  "presets": [{ "name": "LP store locator" }]
}
{% endschema %}
